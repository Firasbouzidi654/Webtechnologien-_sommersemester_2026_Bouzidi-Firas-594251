# .env.example - Environment Variables Template
# Copy this file to .env and fill in with actual values
# NEVER commit .env file to git - it's in .gitignore



# PostgreSQL Database URL (Render production)
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST.frankfurt-postgres.render.com/YOUR_DB_NAME

# Database Credentials
DATABASE_USER=YOUR_DB_USER
DATABASE_PASSWORD=YOUR_DB_PASSWORD

# ========================================
# Spring Boot Configuration
# ========================================

SPRING_PROFILES_ACTIVE=production

SPRING_JPA_HIBERNATE_DDL_AUTO=validate

SPRING_JPA_SHOW_SQL=false



# Server Port (Render uses dynamic PORT environment variable)
PORT=10000
SERVER_PORT=10000



# Enable automatic flyway migrations
FLYWAY_ENABLED=true



LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_DE_HTW_BERLIN=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN
LOGGING_LEVEL_ORG_HIBERNATE_SQL=WARN


VUE_APP_API_URL=https://kindercare-connect-xxxxx.onrender.com/api


VITE_OPENWEATHER_API_KEY=your_free_openweather_api_key
OPENWEATHER_API_KEY=your_free_openweather_api_key


# Internal: postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST/YOUR_DB_NAME
# External: postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST.frankfurt-postgres.render.com/YOUR_DB_NAME

