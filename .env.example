# .env.example - Environment Variables Template
# Copy this file to .env and fill in with actual values
# NEVER commit .env file to git - it's in .gitignore

# ========================================
# Backend Database Configuration
# ========================================

# PostgreSQL Database URL (Render production)
DATABASE_URL=postgresql://demo_user:rFM6UgUtpNItQTXfSWuyWktS1hkPFOLh@dpg-d80eo77lk1mc73da4qcg-a.frankfurt-postgres.render.com/render_db_9td1

# Database Credentials
DATABASE_USER=demo_user
DATABASE_PASSWORD=rFM6UgUtpNItQTXfSWuyWktS1hkPFOLh

# ========================================
# Spring Boot Configuration
# ========================================

# Active Profile (h2, postgresql, production)
SPRING_PROFILES_ACTIVE=production

# JPA/Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Show SQL queries in logs
SPRING_JPA_SHOW_SQL=false

# ========================================
# Server Configuration
# ========================================

# Server Port (Render uses dynamic PORT environment variable)
PORT=10000
SERVER_PORT=10000

# ========================================
# Flyway Database Migration
# ========================================

# Enable automatic flyway migrations
FLYWAY_ENABLED=true

# ========================================
# Logging Configuration
# ========================================

# Log levels
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_DE_HTW_BERLIN=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN
LOGGING_LEVEL_ORG_HIBERNATE_SQL=WARN

# ========================================
# Frontend Configuration
# ========================================

# Frontend API Base URL
VUE_APP_API_URL=https://kindercare-connect-xxxxx.onrender.com/api

# ========================================
# Local Development Configuration
# ========================================

# For local PostgreSQL development:
# DATABASE_URL=jdbc:postgresql://localhost:5432/kindercare
# DATABASE_USER=kindercare_user
# DATABASE_PASSWORD=your_local_password
# SPRING_PROFILES_ACTIVE=postgresql
# PORT=9090

# ========================================
# NOTES FOR RENDER DEPLOYMENT
# ========================================

# 1. Set these environment variables in Render Dashboard:
#    - Go to your Web Service
#    - Environment tab
#    - Add each variable

# 2. For DATABASE_URL on Render:
#    - Found in your PostgreSQL database resource
#    - Use the "External Database URL" from Render
#    - Format: postgresql://user:password@host.render.com/database

# 3. Render automatically provides PORT variable
#    - Do NOT set PORT manually if Render sets it
#    - Application will use PORT from Render environment

# 4. SPRING_PROFILES_ACTIVE must be set to "production"
#    - This activates application-production.properties
#    - Uses optimized settings for Render environment

# 5. Security:
#    - Never commit .env with real credentials
#    - Use Render's Web GUI for sensitive variables
#    - Consider using Render's secret management

# ========================================
# Example: PostgreSQL on Render
# ========================================

# From Render PostgreSQL Resource:
# Internal: postgresql://demo_user:rFM6UgUtpNItQTXfSWuyWktS1hkPFOLh@dpg-d80eo77lk1mc73da4qcg-a/render_db_9td1
# External: postgresql://demo_user:rFM6UgUtpNItQTXfSWuyWktS1hkPFOLh@dpg-d80eo77lk1mc73da4qcg-a.frankfurt-postgres.render.com/render_db_9td1

# Use EXTERNAL URL in application-production.properties because:
# - Internal URL only works between Render services in same region
# - External URL works from anywhere (including local testing)
# - External URL includes full domain with .render.com extension

