# .env.example — copy this to .env and fill in real values
# NEVER commit .env to git. The .gitignore already blocks it.

# ── Database (Render PostgreSQL) ────────────────────────────────────────────
# Full JDBC URL — Render provides postgresql://... format; prefix it with jdbc:
DATABASE_URL=jdbc:postgresql://YOUR_DB_HOST.frankfurt-postgres.render.com/YOUR_DB_NAME

# The username and password shown in Render's "Connection Details"
SPRING_DATASOURCE_USERNAME=YOUR_DB_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# ── Spring Boot ─────────────────────────────────────────────────────────────
# Activate the production profile on Render (uses application-production.properties)
SPRING_PROFILES_ACTIVE=production

# ── Server ──────────────────────────────────────────────────────────────────
# Render injects PORT automatically; set 10000 here only for local .env testing
PORT=10000

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Public URL of the deployed backend — used by the Vue frontend to call the API
VITE_API_BASE_URL=https://YOUR_SERVICE_NAME.onrender.com/api

# Free API key from openweathermap.org (no billing required)
VITE_OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
